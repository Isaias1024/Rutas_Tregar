# Rutas — Transporte de Personal
#
# Copia este archivo a `.env` o deja que `pnpm env:write` lo genere a partir de
# `supabase status`. `.env` NUNCA se versiona; este ejemplo si (ver la excepcion
# `!.env.example` en `.gitignore`).
#
# La columna "Requerida a partir del paso" de la §10 del blueprint es un contrato:
# el validador de arranque (`apps/web/src/lib/env.ts`) exige una variable solo desde
# el paso indicado y la trata como opcional antes. Por eso este archivo puede tener
# valores vacios sin romper la compilacion de los primeros pasos.

# --- Base de datos (paso 2) -------------------------------------------------
# Valor local real que imprime `pnpm exec supabase status`:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Supabase (paso 3) ------------------------------------------------------
# URL local real: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OAuth corporativo (paso 3) --------------------------------------------
# Solo se aceptan correos de este dominio en el panel web.
GOOGLE_OAUTH_ALLOWED_DOMAIN=

# --- Mapas (paso 6) ---------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials.
# Restringir por referer HTTP antes de salir a produccion.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- App del chofer (paso 8) ------------------------------------------------
# Mismos valores que NEXT_PUBLIC_SUPABASE_*; Expo solo expone el prefijo EXPO_PUBLIC_.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Worker (paso 13) -------------------------------------------------------
WORKER_PORT=8787
WORKER_BASE_URL=http://127.0.0.1:8787
# Secreto compartido: el panel lo manda en el header `x-rutas-worker-secret`.
# Generar con: node -e "console.log(crypto.randomUUID())"
WORKER_SHARED_SECRET=

# --- Push (paso 14) ---------------------------------------------------------
# expo.dev -> Account settings -> Access tokens. Solo lo usa el worker.
EXPO_ACCESS_TOKEN=

# --- Operacion (paso 1) -----------------------------------------------------
# Zona horaria operativa. IANA siempre, jamas un offset fijo.
APP_TIMEZONE=America/Mexico_City
LOG_LEVEL=info

# --- Pruebas end to end (paso 5) -------------------------------------------
E2E_BASE_URL=http://127.0.0.1:3000
