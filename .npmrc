node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true

# Varios scripts de package.json usan sintaxis de shell POSIX (`>/dev/null`, `||`).
# En Windows pnpm los correria con cmd.exe, donde `/dev/null` es una ruta invalida
# y `db:up` fallaria. Git Bash provee bash en Windows, y macOS y Linux lo traen de
# fabrica, asi que fijarlo aqui hace que los scripts se comporten igual en las tres.
script-shell=bash
